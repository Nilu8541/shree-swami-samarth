<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Driver Daily Report Portal</title>

<style>
body{
    font-family:Arial,sans-serif;
    background:#f4f6f9;
    padding:15px;
}
.container{
    max-width:700px;
    margin:auto;
    background:#fff;
    padding:20px;
    border-radius:12px;
    box-shadow:0 0 10px rgba(0,0,0,0.15);
}
h2{
    text-align:center;
}
label{
    font-weight:bold;
    margin-top:10px;
    display:block;
}
input,select,textarea{
    width:100%;
    padding:10px;
    margin-top:5px;
    border:1px solid #ccc;
    border-radius:6px;
}
button{
    width:100%;
    padding:12px;
    margin-top:10px;
    border:none;
    border-radius:6px;
    font-size:16px;
    cursor:pointer;
}
.generate{
    background:#007bff;
    color:#fff;
}
.whatsapp{
    background:#25D366;
    color:#fff;
}
.report{
    margin-top:15px;
    background:#eef5ff;
    padding:15px;
    border-radius:8px;
    white-space:pre-line;
}
</style>
</head>

<body>

<div class="container">

<h2>🚗 Driver Daily Report</h2>

<label>Date</label>
<input type="date" id="date">

<label>Driver Name</label>
<input type="text" id="driver">

<label>Shift</label>
<select id="shift">
<option>A Shift</option>
<option>B Shift</option>
<option>C Shift</option>
<option>Night Shift</option>
</select>

<label>Vehicle Number</label>
<input type="text" id="vehicle">

<label>Pickup Time</label>
<input type="time" id="pickup">

<label>Drop Time</label>
<input type="time" id="drop">

<label>Starting KM</label>
<input type="number" id="startkm">

<label>Ending KM</label>
<input type="number" id="endkm">

<label>CNG Cost (₹)</label>
<input type="number" id="cng">

<label>Magarpatta Trips</label>
<input type="number" id="magarpatta" value="0">

<label>Kharadi Trips</label>
<input type="number" id="kharadi" value="0">

<label>Male Employees</label>
<input type="number" id="male" value="0">

<label>Female Employees</label>
<input type="number" id="female" value="0">

<label>Remarks</label>
<textarea id="remarks"></textarea>

<button class="generate" onclick="generateReport()">
Generate Report
</button>

<button class="whatsapp" onclick="sendWhatsApp()">
📲 Send to WhatsApp
</button>

<div id="report" class="report" style="display:none;"></div>

</div>

<script>

document.getElementById("date").value =
new Date().toISOString().split("T")[0];

function generateReport(){

let date=document.getElementById("date").value;
let driver=document.getElementById("driver").value;
let shift=document.getElementById("shift").value;
let vehicle=document.getElementById("vehicle").value;
let pickup=document.getElementById("pickup").value;
let drop=document.getElementById("drop").value;
let start=parseFloat(document.getElementById("startkm").value)||0;
let end=parseFloat(document.getElementById("endkm").value)||0;
let cng=parseFloat(document.getElementById("cng").value)||0;

let mag=parseInt(document.getElementById("magarpatta").value)||0;
let kha=parseInt(document.getElementById("kharadi").value)||0;

let male=parseInt(document.getElementById("male").value)||0;
let female=parseInt(document.getElementById("female").value)||0;

let remarks=document.getElementById("remarks").value;

let totalKm=end-start;
let totalTrips=mag+kha;
let totalEmp=male+female;

let report=
`🚗 DRIVER DAILY REPORT

Date: ${date}
Driver Name: ${driver}
Shift: ${shift}

Vehicle No: ${vehicle}

Pickup Time: ${pickup}
Drop Time: ${drop}

Starting KM: ${start}
Ending KM: ${end}
Total KM: ${totalKm}

CNG Cost: ₹${cng}

Magarpatta Trips: ${mag}
Kharadi Trips: ${kha}
Total Trips: ${totalTrips}

Male Employees: ${male}
Female Employees: ${female}
Total Employees: ${totalEmp}

Remarks: ${remarks}`;

document.getElementById("report").style.display="block";
document.getElementById("report").innerText=report;
}

function sendWhatsApp(){

let report=document.getElementById("report").innerText;

if(report==""){
alert("Please Generate Report First");
return;
}

let phone="918530985372";

let url=
"https://wa.me/"+phone+
"?text="+encodeURIComponent(report);

window.open(url,"_blank");
}
</script>

</body>
</html>
